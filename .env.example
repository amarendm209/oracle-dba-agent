# Oracle connection - values come from your secret store, never commit real values
ORACLE_USER=dba_agent
ORACLE_PASSWORD=
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
# Or provide a full DSN / TNS alias instead of host+port+service
# ORACLE_DSN=

# Agent
DBA_QUERY_TIMEOUT=30
DBA_WEB_HOST=0.0.0.0
DBA_WEB_PORT=8000
# Point the agent at a remote FastMCP server instead of the in-process one
# DBA_MCP_URL=http://127.0.0.1:8765/mcp
